# Public HTTP RPC only. Never put the shared Conduit WebSocket key here.
RPC_URL=https://rpc.testnet-chain.genlayer.com
CHAIN_ID=4221
DB_PATH=./watchlayer.db
PORT=20360
POLL_SECONDS=120  # delay after each snapshot finishes (runs never overlap)
RETENTION_DAYS=14  # prune full-resolution snapshots older than this (epoch-end snapshots are kept)

# Bot (packages/bot). Get the token from @BotFather; keep it only in .env.
TELEGRAM_BOT_TOKEN=
API_URL=http://127.0.0.1:20360
BOT_DB_PATH=./bot.db
ALERT_CHECK_SECONDS=120
SILENT_HOURS=6
# Changelog Guard (Upgrades page + mandatory-upgrade alerts; docs/UPGRADE-ALERT.md). Leave the address empty to disable.
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
CHANGELOG_GUARD_CONSUMER=
CHANGELOG_GUARD_ADDRESS=
NODE_VERSION=
