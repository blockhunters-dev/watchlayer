# blockhunters.services is proxied by Cloudflare in Flexible mode: Cloudflare -> origin over HTTP, so plain HTTP here.
http://watchlayer.blockhunters.services {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	handle_path /api/* {
		reverse_proxy watchlayer-staging-indexer:8080
	}
	reverse_proxy watchlayer-staging-dashboard:3000
}
